# --- OpenRouter (relevance scoring + pitch angles) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Cheap + stable default for high-volume relevance scoring (~1600 calls/search)
PITCHFINDER_RELEVANCE_MODEL=deepseek/deepseek-chat-v3.1
# Higher quality for the writer-facing output (~25 pitch-angle calls/search).
# Sonnet 4.6 — 100% stable JSON, sharp prose. Costs ~$0.15/search.
PITCHFINDER_PITCH_MODEL=anthropic/claude-sonnet-4.6
# Optional — sent to OpenRouter for analytics & free-tier prioritization
OPENROUTER_APP_NAME=pitchfinder
OPENROUTER_HTTP_REFERER=https://github.com/shanda-launchpad/shanda-pitchfinder

# --- Apodex (原 MiroMind 升级版；deep research enrichment for top creators) ---
# Used by `pitchfinder deep-dive` to enrich ranked creators with verified
# 6-12 month context + sharp quotes via Apodex's web search + verification.
APODEX_API_KEY=
APODEX_BASE_URL=https://api.apodex.ai/v1
APODEX_DEEPRESEARCH_MODEL=apodex-1-0-deepresearch

# --- Web discovery (cheap broad creator discovery — `pitchfinder discover-web`) ---
# Brave is primary (fast, 2000 free queries/month); Querit supplements coverage.
# Either one alone works; the tool uses whichever key is present.
# (env names match shanda-pulse so you can reuse the same keys.)
BRAVE_API_KEY=
BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
QUERIT_API_TOKEN=
QUERIT_SEARCH_URL=https://api.querit.ai/v1/search
