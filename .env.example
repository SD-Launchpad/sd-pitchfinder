OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Cheap default for high-volume relevance scoring (~1600 calls/search)
PITCHFINDER_RELEVANCE_MODEL=deepseek/deepseek-chat-v3.1
# Better quality for pitch angle generation (~25 calls/search)
PITCHFINDER_PITCH_MODEL=deepseek/deepseek-chat-v3.1
# Optional — sent to OpenRouter for analytics & free-tier prioritization
OPENROUTER_APP_NAME=pitchfinder
OPENROUTER_HTTP_REFERER=https://github.com/shanda-internal/pitchfinder
