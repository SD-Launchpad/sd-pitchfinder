# --- OpenRouter (relevance scoring + pitch angles) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Cheap default for high-volume relevance scoring (~1600 calls/search)
PITCHFINDER_RELEVANCE_MODEL=deepseek/deepseek-chat-v3.1
# Better quality for pitch angle generation (~25 calls/search)
PITCHFINDER_PITCH_MODEL=deepseek/deepseek-chat-v3.1
# Optional — sent to OpenRouter for analytics & free-tier prioritization
OPENROUTER_APP_NAME=pitchfinder
OPENROUTER_HTTP_REFERER=https://github.com/shanda-launchpad/shanda-pitchfinder

# --- MiroMind / MiroThinker (deep research enrichment for top creators) ---
# Used by `pitchfinder deep-dive` to enrich ranked creators with verified
# 6-12 month context + sharp quotes via MiroThinker's web search + verification.
MIROMIND_API_KEY=
MIROMIND_BASE_URL=https://api.miromind.ai/v1
MIROMIND_DEEPRESEARCH_MODEL=mirothinker-1-7-deepresearch
